# 広告監視エージェントの設定ファイルの見本
# Mac Studio で次のようにコピーして、値を入れてください（このファイル自体には値を書かない）:
#   mkdir -p ~/.config/ricepia-agents
#   cp ads-watch.env.example ~/.config/ricepia-agents/ads-watch.env
#   chmod 600 ~/.config/ricepia-agents/ads-watch.env
# 空のままの項目は使われません（その媒体・通知先はスキップ）。

# ---- Google 広告（tools/google-ads-run.js と同じもの）----
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# ---- Meta 広告（ads_read 権限のシステムユーザーのトークン）----
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
# 「成果」として数える行動（カンマ区切り）。LINE友だち追加を成果にしているなら、そのイベント名を入れる
META_CONVERSION_ACTIONS=lead,omni_purchase,omni_complete_registration

# ---- 通知先（どちらか一方でも可）----
LINE_CHANNEL_ACCESS_TOKEN=
LINE_TO_USER_ID=
RESEND_API_KEY=
ALERT_EMAIL_TO=

# ---- 判定の基準（空なら初期値）----
# 全媒体の1日の広告費の上限（円）。超えたら夜中でも知らせる
#   空 = 自動（直近7日の1日平均 × ADS_AUTO_LIMIT_RATIO。下限 ADS_AUTO_LIMIT_MIN_YEN）／ 0 = 見ない ／ 数字 = その金額
ADS_DAILY_TOTAL_LIMIT_YEN=
ADS_AUTO_LIMIT_RATIO=2
ADS_AUTO_LIMIT_MIN_YEN=3000
# 今日これだけ使って成果0なら知らせる（円）
ADS_NO_CONV_SPEND_YEN=3000
# 日予算の何倍で知らせるか
ADS_OVER_BUDGET_RATIO_GOOGLE=1.8
ADS_OVER_BUDGET_RATIO_META=1.6
# 夜間（この時間は急ぎ以外を朝に回す）
ADS_QUIET_START_HOUR=22
ADS_QUIET_END_HOUR=7

# ---- その他 ----
# 死活監視サービス（Healthchecks.io など）の URL。Mac が止まったら向こうから知らせてくれる
HEARTBEAT_URL=
# 毎晩のバックアップ（agents/nightly-backup）の死活監視 URL。成功した夜だけ知らせる
BACKUP_HEARTBEAT_URL=
# 報告に使うモデル（空なら Claude Code の既定）
ADS_REPORT_MODEL=
