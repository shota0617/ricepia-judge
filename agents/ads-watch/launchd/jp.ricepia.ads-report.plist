<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 朝の報告（7:30）と1日のまとめ（20:00）（install.sh が __DIR__ と __HOME__ を置き換えて登録する） -->
<plist version="1.0">
<dict>
  <key>Label</key><string>jp.ricepia.ads-report</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__DIR__/report.sh</string></array>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>30</integer></dict>
    <dict><key>Hour</key><integer>20</integer><key>Minute</key><integer>0</integer></dict>
  </array>
  <key>StandardOutPath</key><string>__HOME__/ricepia-agents/ads-watch/logs/report.log</string>
  <key>StandardErrorPath</key><string>__HOME__/ricepia-agents/ads-watch/logs/report.log</string>
</dict>
</plist>
