<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- 毎晩2時のTime Machineバックアップ（install.sh が __LIB__ を置き換えて /Library/LaunchDaemons に登録する） -->
<plist version="1.0">
<dict>
  <key>Label</key><string>jp.ricepia.nightly-backup</string>
  <key>ProgramArguments</key>
  <array><string>/bin/zsh</string><string>__LIB__/nightly-backup.sh</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Library/Logs/ricepia-nightly-backup.log</string>
  <key>StandardErrorPath</key><string>/Library/Logs/ricepia-nightly-backup.log</string>
</dict>
</plist>
