# ===== 必須（本番） =====
# 公開URL（https 必須：ブラウザは https でないとカメラ・マイクを使わせません）
BASE_URL=https://reji.example.com
# 店員ログイン用パスワード（長く推測されないもの）
STAFF_PASSWORD=
# Cookie 署名用の鍵（未設定なら data/ に自動生成）
SESSION_SECRET=

# ===== お店の情報（レシートに印字） =====
STORE_NAME=らいすぴあ
STORE_ADDRESS=
STORE_TEL=
# 適格請求書発行事業者の登録番号（T + 13桁）
INVOICE_NO=

# ===== クレジットカード（Stripe）未設定ならデモ（擬似決済） =====
# カード番号はお客様が自分のスマホで Stripe の決済ページ（checkout.stripe.com）に入力します
STRIPE_SECRET_KEY=sk_live_...
# Webhook（任意）：エンドポイント https://<BASE_URL>/webhooks/stripe 、イベント checkout.session.completed / checkout.session.expired
# （届かなくても数秒ごとの確認で支払い完了を検知します）
STRIPE_WEBHOOK_SECRET=whsec_...

# ===== PayPay（PayPay for Developers）未設定ならデモ（擬似決済） =====
PAYPAY_API_KEY=
PAYPAY_API_SECRET=
PAYPAY_MERCHANT_ID=
# sandbox（テスト）または production（本番）
PAYPAY_ENV=sandbox

# ===== ビデオ通話の接続補助（TURN サーバー） =====
# 携帯回線・会社のネットワーク同士だと STUN だけでは繋がらないことがあります。本番では TURN を設定してください。
# 例：Cloudflare Calls TURN / Twilio Network Traversal / 自前の coturn
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
TURN_USERNAME=
TURN_CREDENTIAL=

# リバースプロキシ（nginx 等）の後ろで動かす場合、レート制限に X-Forwarded-For を使う
# TRUST_PROXY=1
PORT=3000
